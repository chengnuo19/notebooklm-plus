{
  "manifest_version": 3,
  "name": "NotebookLM Plus",
  "version": "0.1.3",
  "description": "为 Google NotebookLM 增强:Quiz 出题提示词、错题复习与一键导出。",
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*",
    "https://notebooklm.google.com/*",
    "https://*.scf.usercontent.goog/*"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/assets/mathjax.js",
        "src/common/question-dedup.js",
        "src/common/anki-export.js",
        "src/common/storage.js",
        "src/common/notion-api.js",
        "src/common/quiz-review-markdown.js",
        "src/content/dom.js",
        "src/content/md.js",
        "src/content/styles.js",
        "src/content/export.js",
        "src/content/chat-width.js",
        "src/content/keyboard.js",
        "src/content/chat-enhance.js",
        "src/content/prompt-library.js",
        "src/content/timeline.js",
        "src/content/quiz-prompt.js",
        "src/content/quiz-observer.js",
        "src/content/quiz-chat-capture.js",
        "src/content/quiz-explain.js",
        "src/content/quiz-review.js",
        "src/content/good-review.js",
        "src/content/quiz-ai-review.js",
        "src/content/toolbar.js",
        "src/content/bootstrap.js"
      ]
    }
  ],
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "NotebookLM Plus",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  }
}
